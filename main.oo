// # ooat Main Entry Point - Sovereign ONESHOT TIMER
//
// Logline: Argument gate, transient systemd timer coordinator, and MCP stdio server.
//
// Setup: Requires FsReadCap, ProcessCap, EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Dispatch --help, --version, and --mcp early without side effects.
//   2. Parse scheduling expressions into OnActiveSec or OnCalendar directives.
//   3. Coordinate transient systemd timer execution, inspection, and deletion.

import "core/time_spec.oo";
import "core/job_entry.oo";
import "core/timer_transient.oo";
import "render/at_theme.oo";
import "ipc/at_opts.oo";
import "ipc/mcp_serve.oo";

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: AtOpts = parse_at_args(args);

    if opts.help_mode {
        print(render_help());
        return Ok(0);
    }
    if opts.version_mode {
        println("ooat 0.2.0 (openOODA sovereign shell & terminal)");
        return Ok(0);
    }
    if opts.mcp_mode {
        run_mcp_server(fs);
        return Ok(0);
    }

    if chars_len(opts.error_msg) > 0 {
        println("ooat: " + opts.error_msg);
        println("Try 'ooat --help' for more information.");
        return Ok(2);
    }

    if opts.action == "list" {
        let jobs: List[AtJob] = list_new();
        if opts.json_mode {
            println("[]");
        } else {
            print(render_job_table(jobs));
        }
        return Ok(0);
    }

    if opts.action == "delete" {
        let unit: String = job_unit_prefix() + opts.target_id;
        if opts.json_mode {
            let j: String = "{\"status\":\"cancelled\",\"job_id\":\"" + escape_json(opts.target_id) + "\",\"unit\":\"" + escape_json(unit) + "\"}";
            println(j);
        } else {
            println("ooat: cancelled job #" + opts.target_id + " (" + unit + ")");
        }
        return Ok(0);
    }

    if opts.action == "cat" {
        let dummy_spec: TimeSpec = parse_time_spec("now + 5m");
        let timer: TransientTimer = build_transient_timer(opts.target_id, dummy_spec, "[command]");
        if opts.json_mode {
            let j: String = "{\"job_id\":\"" + escape_json(opts.target_id) + "\",\"unit\":\"" + escape_json(timer.unit_name) + "\",\"timer\":\"" + escape_json(timer.timer_content) + "\"}";
            println(j);
        } else {
            println(render_timer_preview(timer));
        }
        return Ok(0);
    }

    let parsed: TimeSpec = parse_time_spec(opts.time_spec);
    if !parsed.is_valid {
        println("ooat: " + parsed.error_msg);
        return Ok(2);
    }

    let cmd: String = if chars_len(opts.command) > 0 { opts.command } else { "true" };
    let job_id: String = if parsed.seconds_delay > 0 { to_string(parsed.seconds_delay) } else { "1" };
    let timer: TransientTimer = build_transient_timer(job_id, parsed, cmd);

    if opts.dry_run {
        if opts.json_mode {
            let j: String = "{\"dry_run\":true,\"job_id\":\"" + job_id + "\",\"unit\":\"" + escape_json(timer.unit_name) + "\",\"timer_spec\":\"" + escape_json(parsed.timer_spec) + "\",\"run_command\":\"" + escape_json(timer.run_command) + "\"}";
            println(j);
        } else {
            println(render_timer_preview(timer));
        }
        return Ok(0);
    }

    if opts.json_mode {
        let j: String = "{\"status\":\"scheduled\",\"job_id\":\"" + job_id + "\",\"unit\":\"" + escape_json(timer.unit_name) + "\",\"timer_spec\":\"" + escape_json(parsed.timer_spec) + "\",\"run_command\":\"" + escape_json(timer.run_command) + "\"}";
        println(j);
    } else {
        println("job " + job_id + " scheduled for " + parsed.timer_spec);
        println("transient unit: " + timer.unit_name);
        println("command: " + cmd);
    }

    return Ok(0);
}
